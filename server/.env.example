# MODE=mock runs with no Ring, no AWS, no hardware. Everything below is for MODE=live.
MODE=mock
DATA_DIR=data
PUBLIC_BASE_URL=https://watermark.example.com
WEB_ORIGIN=http://localhost:3000
DEV_TOOLS=1
LOG_LEVEL=INFO

# Ring Developer Portal credentials (never commit real values)
RING_CLIENT_ID=
RING_CLIENT_SECRET=
RING_HMAC_KEY=
RING_API_BASE=https://api.amazonvision.com

# Capture: whep needs `pip install -e "server[capture]"` (aiortc)
CAPTURE_BACKEND=whep
CAPTURE_INTERVAL_S=300
CAPTURE_SESSION_S=55
CAPTURE_FPS=1

# Captions: bedrock needs AWS credentials in the environment or ~/.aws
CAPTIONS_BACKEND=bedrock
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
AWS_REGION=us-east-1

# Blobs
BLOB_BACKEND=s3
S3_BUCKET=

# Rover dispatch: local (HTTP long-poll) or iot (AWS IoT Core)
DISPATCH_BACKEND=local
IOT_ENDPOINT=
IOT_TOPIC_PREFIX=watermark/rover
ROVER_TOKEN=change-me
ROVER_WAIT_S=90

# Aftermath findings backend: mock | bedrock | ollama | claude
BRAIN_BACKEND=bedrock
RECONCILE_INTERVAL_S=60
