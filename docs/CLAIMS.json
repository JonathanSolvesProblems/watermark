{
  "_comment": "Each headline number in the docs must trace to a committed run in docs/runs/. Run files are the pack.json of a real incident (copy it there). Until docs/runs/demo-run.json exists, bracketed placeholders like [N] are allowed and real numbers are failures.",
  "runs": {
    "demo": "docs/runs/demo-run.json",
    "ablation": "docs/runs/ablation-run.json",
    "playground": "docs/runs/playground-series.json"
  },
  "watch_files": [
    "README.md",
    "docs/DEMO_SCRIPT.md",
    "docs/SUBMISSION.md"
  ],
  "claims": [
    {
      "id": "playground_first_frame_median",
      "text": "median seconds from a simulated sensor event to the first frame from Ring's Playground doorbell",
      "docs_regex": "first Ring frame arrived \\[?([0-9.]+|N)\\]? ?s after",
      "run": "playground",
      "path": "median_s",
      "tolerance": 0.05
    },
    {
      "id": "playground_runs",
      "text": "number of Playground runs behind the median",
      "docs_regex": "median of \\[?([0-9]+|N)\\]? runs",
      "run": "playground",
      "path": "n",
      "tolerance": 0
    },
    {
      "id": "playground_min",
      "text": "fastest Playground run",
      "docs_regex": "range ([0-9.]+) to [0-9.]+ s",
      "run": "playground",
      "path": "min_s",
      "tolerance": 0.05
    },
    {
      "id": "playground_max",
      "text": "slowest Playground run",
      "docs_regex": "range [0-9.]+ to ([0-9.]+) s",
      "run": "playground",
      "path": "max_s",
      "tolerance": 0.05
    },
    {
      "id": "first_frame_s",
      "text": "seconds from sensor to first Ring frame",
      "docs_regex": "first frame (?:within|in|at) \\[?([0-9.]+|N)\\]? ?s",
      "run": "demo",
      "path": "integrity.stats.sensor_to_first_frame_s",
      "tolerance": 0.5
    },
    {
      "id": "on_station_s",
      "text": "seconds from sensor to rover on station",
      "docs_regex": "on station (?:in|after|at) \\[?([0-9.]+|N)\\]? ?s",
      "run": "demo",
      "path": "integrity.stats.sensor_to_on_station_s",
      "tolerance": 0.5
    },
    {
      "id": "questions_answered",
      "text": "claim questions answered",
      "docs_regex": "answers \\[?([0-9]+|N)\\]? of \\[?(?:[0-9]+|M)\\]? questions",
      "run": "demo",
      "path": "claims.answered",
      "tolerance": 0
    },
    {
      "id": "questions_total",
      "text": "claim questions total",
      "docs_regex": "answers \\[?(?:[0-9]+|N)\\]? of \\[?([0-9]+|M)\\]? questions",
      "run": "demo",
      "path": "claims.total",
      "tolerance": 0
    },
    {
      "id": "ablation_motion_events",
      "text": "motion recordings in the Ring app's event history while the tray filled, with Watermark off",
      "docs_regex": "event history shows \\[?([0-9]+|N)\\]? motion recordings",
      "run": "ablation",
      "path": "ring_app_motion_events",
      "tolerance": 0
    }
  ]
}
